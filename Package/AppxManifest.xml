<?xml version="1.0" encoding="utf-8"?>
<!--
  RoxaZip - sparse package for the modern (Windows 11) File Explorer context menu.

  This package contains no binaries. It gives the already installed RoxaZip
  (RoxaZipShell.dll + RoxaZipFM.exe) a package identity and registers the IExplorerCommand
  implementation of RoxaZipShell.dll as a "windows.fileExplorerContextMenus" command,
  so "RoxaZip" appears directly in the Windows 11 context menu (with a cascaded
  submenu), instead of only in "Show more options".

  Identity/@Publisher must match the subject of the code signing certificate.
  See build-shell-package.ps1.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 com desktop4 desktop5 rescap">

  <Identity
    Name="RoxaZip.ShellExtension"
    Publisher="CN=RoxaZip Sparse Package"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>RoxaZip Shell Extension</DisplayName>
    <PublisherDisplayName>RoxaZip</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="RoxaZip.FileManager"
      Executable="RoxaZipFM.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="RoxaZip"
        Description="RoxaZip file manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- The shell extension DLL of RoxaZip. It is loaded by dllhost.exe
             (surrogate) and must be present in the external location
             (the RoxaZip installation directory). -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="RoxaZip Shell Extension">
              <com:Class
                Id="3878DDB7-37F6-4265-BB4F-835DC2A790ED"
                Path="RoxaZipShell.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- The cascaded "RoxaZip" submenu of the Windows 11 context menu.
             The CLSID is the CLSID_CZipContextMenu of this fork, and the
             submenu items come from IExplorerCommand::EnumSubCommands(). -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="RoxaZipFiles" Clsid="3878DDB7-37F6-4265-BB4F-835DC2A790ED" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="RoxaZipDirectory" Clsid="3878DDB7-37F6-4265-BB4F-835DC2A790ED" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="RoxaZipBackground" Clsid="3878DDB7-37F6-4265-BB4F-835DC2A790ED" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
